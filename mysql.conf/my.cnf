[client]
port = 3306
socket = /var/lib/mysql/mysql.sock

[mysqld]
port = 3306
socket = /var/lib/mysql/mysql.sock
# --- Base ---
skip-name-resolve
skip-external-locking
default-time-zone = '+08:00'
explicit_defaults_for_timestamp = true
default-storage-engine = InnoDB
transaction_isolation = REPEATABLE-READ
server-id = 1
# --- Connection and Cache ---
back_log = 4096
max_connections = 800
max_connect_errors = 1000
table_open_cache = 2048
thread_cache_size = 128
max_allowed_packet = 128M
# --- Close query cache ---
query_cache_size = 0
query_cache_type = 0
# --- Core safe ---
tmp_table_size = 64M
max_heap_table_size = 64M
read_buffer_size = 2M
read_rnd_buffer_size = 2M
sort_buffer_size = 2M
join_buffer_size = 4M
thread_stack = 256K
# --- Binlog ---
log-bin = mysql-bin
binlog_format = row
binlog_cache_size = 2M
expire_logs_days = 7
sync_binlog = 1
# --- MyISAM ---
key_buffer_size = 32M
bulk_insert_buffer_size = 16M
# --- InnoDB Config ---
# innodb_buffer_pool_size
# + key_buffer_size
# + max_connections*(sort_buffer_size+read_buffer_size+binlog_cache_size)
# + max_connections*2MB
innodb_buffer_pool_size = 12G
# this option takes effect only when innodb_buffer_pool_size >= 1GB
innodb_buffer_pool_instances = 8
# max depends on the maximum file size of the operating system
innodb_data_file_path = ibdata1:50M:autoextend
# 1 is transaction safe
innodb_flush_log_at_trx_commit = 1
innodb_log_buffer_size = 32M
# innodb_log_file_size * innodb_log_files_in_group < 521G
innodb_log_file_size = 1G
innodb_log_files_in_group = 2
innodb_max_dirty_pages_pct = 75
innodb_lock_wait_timeout = 60
# 5.7 default is Barracuda, The previous default value was Antelope
#innodb_file_format = Barracuda
# --- Slow Query Log ---
long_query_time = 1
slow_query_log = 1
slow_query_log_file = /var/log/mysql-slow.log
event_scheduler = 1
# --- Sql Mode ---
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

[mysqldump]
quick
max_allowed_packet = 128M

[mysql]
no-auto-rehash

[myisamchk]
key_buffer_size = 32M
sort_buffer_size = 32M
read_buffer = 2M
write_buffer = 2M

[mysqld_safe]
open-files-limit = 51200
log-error = /var/log/mysql-error.log
